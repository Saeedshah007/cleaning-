# این فایل رو کپی کن به .env و مقادیر واقعی رو بذار. هیچ‌وقت .env رو commit نکن.

# یه رشتهٔ تصادفی طولانی برای امضای نشست ورود (مثلاً: openssl rand -hex 32)
JWT_SECRET=

# منطقهٔ زمانی واقعی خونه — این خیلی مهمه، وگرنه ددلاین نیمه‌شب اشتباه می‌شه
# مثال‌ها: America/Toronto ، America/Vancouver ، Asia/Tehran ، Europe/London
APP_TIMEZONE=UTC

# یه رمز دلخواه که فقط سرویس کرون بیرونی (cron-job.org) و شما می‌دونید
CRON_SECRET=

# ساعت محلی یادآوری عصرگاهی (پیش‌فرض ۲۱ یعنی ۹ شب طبق APP_TIMEZONE)
REMINDER_HOUR=21
REMINDER_WINDOW_MINUTES=20

# با: npm run gen-vapid بساز
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# محلی: خالی بذار (از فایل SQLite لوکال استفاده می‌کنه). پروداکشن: از Turso بگیر.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

NODE_ENV=development
PORT=3000
